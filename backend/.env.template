# App Port
PORT=3000

# Supabase Configuration
# URL del proyecto Supabase (ej. https://xyz.supabase.co)
SUPABASE_URL=tu-url-de-supabase
# Anon key de Supabase para acceso público/client-side
SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# PostgreSQL Connection (Supabase)
# Host de la base de datos (puedes encontrarlo en los ajustes de DB en Supabase)
DB_HOST=db.tu-proyecto.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu-contraseña-de-db
DB_DATABASE=postgres

# Firebase Configuration (Solo para Notificaciones Push)
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="tu-clave-privada-firebase"
